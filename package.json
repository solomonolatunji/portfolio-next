    "@tailwindcss/vite": "^4.3.3",
    "@takumi-rs/core": "^2.9.2",
    "@takumi-rs/wasm": "^2.9.2",
    "@tanstack/vue-query": "^5.101.4",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "marked": "^18.0.14",
    "mysql2": "^3.23.3",
    "nuxt": "^4.5.2",
    "nuxt-og-image": "^6.7.8",
