    "@takumi-rs/core": "^2.14.0",
    "@takumi-rs/wasm": "^2.14.0",
    "@tanstack/vue-query": "^5.104.1",
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "marked": "^18.0.14",
    "mysql2": "^3.24.5",
    "nuxt": "^4.5.2",
    "nuxt-og-image": "^6.10.3",
