    "db:migrate": "drizzle-kit migrate",
    "lint": "eslint .",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
